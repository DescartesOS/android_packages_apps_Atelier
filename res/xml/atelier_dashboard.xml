<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/crdroid_settings_title">

    <com.android.settingslib.widget.LayoutPreference
        android:key="atelier_quick_access"
        android:layout="@layout/top_dashboard"
        android:selectable="false"
        settings:allowDividerBelow="false" />

    <PreferenceCategory
        android:key="atelier_more"
        android:layout="@layout/settingslib_expressive_untitled_preference_category">

        <Preference
            android:key="atelier_lockscreen"
            android:icon="@drawable/ic_lockscreen"
            android:title="@string/lockscreen_title"
            android:summary="@string/lockscreen_summary"
            android:fragment="com.crdroid.settings.fragments.LockScreen" />

        <Preference
            android:key="atelier_notifications"
            android:icon="@drawable/atelier_ic_notifications"
            android:title="@string/notifications_title"
            android:summary="@string/atelier_notifications_summary"
            android:fragment="com.crdroid.settings.fragments.Notifications" />

        <Preference
            android:key="atelier_buttons"
            android:icon="@drawable/atelier_ic_buttons"
            android:title="@string/button_title"
            android:summary="@string/atelier_buttons_summary"
            android:fragment="com.crdroid.settings.fragments.Buttons" />

        <Preference
            android:key="atelier_sound"
            android:icon="@drawable/atelier_ic_sound"
            android:title="@string/sound_title"
            android:summary="@string/atelier_sound_summary"
            android:fragment="com.crdroid.settings.fragments.Sound" />

        <Preference
            android:key="atelier_misc"
            android:icon="@drawable/atelier_ic_misc"
            android:title="@string/misc_title"
            android:summary="@string/atelier_misc_summary"
            android:fragment="com.crdroid.settings.fragments.Miscellaneous" />

        <Preference
            android:key="atelier_about"
            android:icon="@drawable/atelier_ic_about"
            android:title="@string/about_crdroid"
            android:fragment="com.crdroid.settings.fragments.About" />
    </PreferenceCategory>
</PreferenceScreen>
