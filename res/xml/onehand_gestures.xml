<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/onehand_title">
    <com.crdroid.settings.preferences.SecureSettingSwitchPreference android:key="onehand_enabled" android:title="@string/onehand_enabled" android:defaultValue="false" />
    <com.crdroid.settings.preferences.SecureSettingSwitchPreference android:key="onehand_left_enabled" android:title="@string/onehand_left_enabled" android:defaultValue="true" android:dependency="onehand_enabled" />
    <com.crdroid.settings.preferences.SecureSettingSwitchPreference android:key="onehand_right_enabled" android:title="@string/onehand_right_enabled" android:defaultValue="true" android:dependency="onehand_enabled" />
    <com.crdroid.settings.preferences.SecureSettingSwitchPreference android:key="onehand_haptic" android:title="@string/onehand_haptic" android:defaultValue="true" android:dependency="onehand_enabled" />
    <com.crdroid.settings.preferences.SecureSettingSwitchPreference android:key="onehand_landscape" android:title="@string/onehand_landscape" android:defaultValue="false" android:dependency="onehand_enabled" />
    <PreferenceCategory android:title="@string/onehand_geometry">
        <com.crdroid.settings.preferences.SecureSettingSeekBarPreference android:key="onehand_width" android:title="@string/onehand_width" android:defaultValue="20" settings:min="8" android:max="40" settings:interval="1" settings:units="dp" android:dependency="onehand_enabled" />
        <com.crdroid.settings.preferences.SecureSettingSeekBarPreference android:key="onehand_height" android:title="@string/onehand_height" android:defaultValue="40" settings:min="10" android:max="80" settings:interval="5" settings:units="%" android:dependency="onehand_enabled" />
        <com.crdroid.settings.preferences.SecureSettingSeekBarPreference android:key="onehand_position" android:title="@string/onehand_position" android:defaultValue="55" settings:min="10" android:max="90" settings:interval="5" settings:units="%" android:dependency="onehand_enabled" />
        <com.crdroid.settings.preferences.SecureSettingSeekBarPreference android:key="onehand_distance" android:title="@string/onehand_distance" android:defaultValue="48" settings:min="24" android:max="120" settings:interval="4" settings:units="dp" android:dependency="onehand_enabled" />
        <com.crdroid.settings.preferences.SecureSettingSeekBarPreference android:key="onehand_hold" android:title="@string/onehand_hold" android:defaultValue="300" settings:min="200" android:max="1000" settings:interval="50" settings:units="ms" android:dependency="onehand_enabled" />
        <com.crdroid.settings.preferences.SecureSettingSeekBarPreference android:key="onehand_opacity" android:title="@string/onehand_opacity" android:defaultValue="35" settings:min="0" android:max="100" settings:interval="5" settings:units="%" android:dependency="onehand_enabled" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/onehand_left">
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_left_short_straight" android:title="@string/onehand_short_straight" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="1" android:summary="%s" android:dependency="onehand_left_enabled" />
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_left_short_up" android:title="@string/onehand_short_up" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="1" android:summary="%s" android:dependency="onehand_left_enabled" />
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_left_short_down" android:title="@string/onehand_short_down" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="1" android:summary="%s" android:dependency="onehand_left_enabled" />
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_left_long_straight" android:title="@string/onehand_long_straight" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="0" android:summary="%s" android:dependency="onehand_left_enabled" />
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_left_long_up" android:title="@string/onehand_long_up" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="0" android:summary="%s" android:dependency="onehand_left_enabled" />
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_left_long_down" android:title="@string/onehand_long_down" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="0" android:summary="%s" android:dependency="onehand_left_enabled" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/onehand_right">
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_right_short_straight" android:title="@string/onehand_short_straight" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="1" android:summary="%s" android:dependency="onehand_right_enabled" />
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_right_short_up" android:title="@string/onehand_short_up" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="1" android:summary="%s" android:dependency="onehand_right_enabled" />
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_right_short_down" android:title="@string/onehand_short_down" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="1" android:summary="%s" android:dependency="onehand_right_enabled" />
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_right_long_straight" android:title="@string/onehand_long_straight" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="0" android:summary="%s" android:dependency="onehand_right_enabled" />
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_right_long_up" android:title="@string/onehand_long_up" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="0" android:summary="%s" android:dependency="onehand_right_enabled" />
        <com.crdroid.settings.preferences.SecureSettingListPreference android:key="onehand_right_long_down" android:title="@string/onehand_long_down" android:entries="@array/onehand_action_entries" android:entryValues="@array/onehand_action_values" android:defaultValue="0" android:summary="%s" android:dependency="onehand_right_enabled" />
    </PreferenceCategory>
    <com.android.settingslib.widget.FooterPreference android:summary="@string/onehand_usage" />
</PreferenceScreen>
