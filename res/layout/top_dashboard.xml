<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutAnimation="@anim/descartes_stagger"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/atelier_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/atelier_version_chip"
        android:fontFamily="variable-label-large"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/settingslib_materialColorOnSecondaryContainer"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutAnimation="@anim/descartes_stagger"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/themes"
            style="@style/AtelierTile"
            android:background="@drawable/top_menu_left_top">

            <ImageView
                style="@style/AtelierTileIcon"
                android:src="@drawable/ic_homepage_themes" />

            <TextView
                style="@style/AtelierTileTitle"
                android:text="@string/ui_title" />

            <TextView
                style="@style/AtelierTileSummary"
                android:text="@string/prismatic_summary" />
        </LinearLayout>

        <Space android:layout_width="4dp" android:layout_height="0dp" />

        <LinearLayout
            android:id="@+id/lockscreen"
            style="@style/AtelierTile"
            android:background="@drawable/top_menu_top_right">

            <ImageView
                style="@style/AtelierTileIcon"
                android:src="@drawable/ic_homepage_lockscreen" />

            <TextView
                style="@style/AtelierTileTitle"
                android:text="@string/lockscreen_title" />

            <TextView
                style="@style/AtelierTileSummary"
                android:text="@string/lockscreen_summary" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutAnimation="@anim/descartes_stagger"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/statusbar"
            style="@style/AtelierTile"
            android:background="@drawable/top_menu_left_bottom">

            <ImageView
                style="@style/AtelierTileIcon"
                android:src="@drawable/ic_homepage_status" />

            <TextView
                style="@style/AtelierTileTitle"
                android:text="@string/statusbar_title" />

            <TextView
                style="@style/AtelierTileSummary"
                android:text="@string/status_summary" />
        </LinearLayout>

        <Space android:layout_width="4dp" android:layout_height="0dp" />

        <LinearLayout
            android:id="@+id/controll"
            style="@style/AtelierTile"
            android:background="@drawable/top_menu_right_bottom">

            <ImageView
                style="@style/AtelierTileIcon"
                android:src="@drawable/ic_homepage_controll" />

            <TextView
                style="@style/AtelierTileTitle"
                android:text="@string/quicksettings_title" />

            <TextView
                style="@style/AtelierTileSummary"
                android:text="@string/quick_settings_summary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
